# --- Database (Neon) ---
# Copy your connection string from the Neon dashboard (or Vercel env var).
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Where users live ---
PUBLIC_SITE_URL="https://lvm-psi.vercel.app"   # your frontend
BACKEND_URL="https://your-backend.onrender.com" # public URL of THIS backend
PORT=4000

# --- Payment gateway ---
# "toyyibpay" uses Malaysian FPX online banking + cards. Use "manual" to test
# the full flow without a real gateway (no money moves).
PAYMENT_GATEWAY="toyyibpay"

# ToyyibPay credentials (https://toyyibpay.com -> Account settings / Category)
TOYYIBPAY_BASE_URL="https://toyyibpay.com"     # or https://dev.toyyibpay.com (sandbox)
TOYYIBPAY_SECRET_KEY="your-user-secret-key"
TOYYIBPAY_CATEGORY_CODE="your-category-code"
